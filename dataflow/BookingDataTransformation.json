{
	"name": "BookingDataTransformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "booking_data_cosmos",
						"type": "DatasetReference"
					},
					"name": "BookingData",
					"description": "input data from bookingdatacosmos"
				},
				{
					"dataset": {
						"referenceName": "booking_data_cosmos",
						"type": "DatasetReference"
					},
					"name": "SynapseForLookup"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "DataQualityCheck"
				},
				{
					"name": "derivedColumn"
				},
				{
					"name": "LookupInSynapse"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     enableChangeFeed: true,",
				"     changeFeedStartFromTheBeginning: false,",
				"     format: 'document') ~> BookingData",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'document') ~> SynapseForLookup",
				"BookingData split(check_out_date<check_in_date,",
				"     disjoint: true) ~> DataQualityCheck@(BadRecords, AcceptedRecords)",
				"DataQualityCheck@AcceptedRecords derive(stay_duration = toTimestamp(ch, timestamp_format, time_zone, locale),",
				"          booking_year = (check_in_date)/86400000,",
				"          booking_month = ERROR_FUNCTION(''),",
				"          full_address = (concat(property_location_city,',',property_location_country)),",
				"          city = ERROR_FUNCTION(''),",
				"          country = ERROR_FUNCTION(''),",
				"          booking_id = ERROR_FUNCTION(''),",
				"          check_out_date = toTimestamp(check_out_date)-toTimestamp(check_in_date)/86400000,",
				"          customer_id = ERROR_FUNCTION(''),",
				"          owner_id = ERROR_FUNCTION(''),",
				"          check_in_date = ERROR_FUNCTION(''),",
				"          timestamp = ERROR_FUNCTION(''),",
				"          property_id = ERROR_FUNCTION(''),",
				"          amount = ERROR_FUNCTION(''),",
				"          currency = ERROR_FUNCTION('')) ~> derivedColumn",
				"derivedColumn, SynapseForLookup lookup(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     multiple: false,",
				"     pickup: 'first',",
				"     desc(synapseforlookup@timestamp, true),",
				"     broadcast: 'auto')~> LookupInSynapse"
			]
		}
	}
}