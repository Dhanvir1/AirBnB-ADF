				"annotations": [],
				"type": "CosmosDb",
				"typeProperties": {
					"accountEndpoint": "[parameters('CosmosDbNew_properties_typeProperties_accountEndpoint')]",
					"database": "[parameters('CosmosDbNew_properties_typeProperties_database')]"
				}
			},
			"dependsOn": []
