{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AirBnB-Project-DF"
		},
		"AirBnBADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://airbnbprojectsacc3.dfs.core.windows.net/"
		},
		"CosmosDbNew_properties_typeProperties_accountEndpoint": {
			"type": "string",
			"defaultValue": "https://azure-cosmos-10.documents.azure.com:443/"
		},
		"CosmosDbNew_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AirBnB"
		},
		"SynapseDWH_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "project1-synapse01.sql.azuresynapse.net"
		},
		"SynapseDWH_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AirBnBSqlPool"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AirBnB-Project-DF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AirBnBADLS_properties_typeProperties_url": {
						"value": "[parameters('AirBnBADLS_properties_typeProperties_url')]"
					},
					"CosmosDbNew_properties_typeProperties_accountEndpoint": {
						"value": "[parameters('CosmosDbNew_properties_typeProperties_accountEndpoint')]"
					},
					"CosmosDbNew_properties_typeProperties_database": {
						"value": "[parameters('CosmosDbNew_properties_typeProperties_database')]"
					},
					"SynapseDWH_properties_typeProperties_server": {
						"value": "[parameters('SynapseDWH_properties_typeProperties_server')]"
					},
					"SynapseDWH_properties_typeProperties_database": {
						"value": "[parameters('SynapseDWH_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}